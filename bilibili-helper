#!/usr/bin/env python3
"""
bilibili-helper — VPS Radio Bilibili 音源辅助工具
实现:
  - 纯游客 0 账号匿名免登录解析
  - WBI 动态签名与密钥缓存
  - 移动端 b23.tv 短链与 App 杂乱文案提纯
  - 单视频 / 分 P 视频 / 公开收藏夹 / 合集 / 关键词搜索
  - DASH 纯音频 (AAC/m4s) 提取与 ffmpeg PCM 直推
  - 超长音频 (>2h) 自动断点接力续播保护

标准库零外部依赖 (Python 3.8+)。
"""
import os
import sys
import re
import json
import time
import signal
import subprocess
import urllib.request
import urllib.parse
from functools import reduce
from hashlib import md5

SEARCH_CACHE = "/run/radiod/bilibili_search.cache"
COOKIE_FILE = "/var/lib/radiod/bilibili_cookie"
KEY_CACHE_FILE = "/tmp/bilibili_wbi_keys.json"

USER_AGENT = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"
REFERER = "https://www.bilibili.com/"

# 字符顺序打乱表 (Bilibili WBI 全站通用)
MIXIN_KEY_ENC_TAB = [
    46, 47, 18, 2, 53, 8, 23, 32, 15, 50, 10, 31, 58, 3, 45, 35, 27, 43, 5, 49,
    33, 9, 42, 19, 29, 28, 14, 39, 12, 38, 41, 13, 37, 48, 7, 16, 24, 55, 40,
    61, 26, 17, 0, 1, 60, 51, 30, 4, 22, 25, 54, 21, 56, 59, 6, 63, 57, 62, 11,
    36, 20, 34, 44, 52
]


if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
if hasattr(sys.stderr, "reconfigure"):
    sys.stderr.reconfigure(encoding="utf-8", errors="replace")

def log(msg: str):
    sys.stderr.write(f"bilibili-helper: {msg}\n")
    sys.stderr.flush()


def die(msg: str, code: int = 1):
    log(f"错误: {msg}")
    sys.exit(code)


import html

def clean_title(s: str) -> str:
    """清洗标题中的 HTML 实体、标签、竖线、回车换行符，保护状态文件与显示。"""
    if not s:
        return "未知标题"
    s = html.unescape(s)
    s = re.sub(r"<[^>]+>", "", s)
    s = s.replace("|", "／").replace("\r", " ").replace("\n", " ")
    return re.sub(r"\s+", " ", s).strip()


def get_cookie() -> str:
    """读取预留的可选 Cookie 文件，未配置时返回空字符串（纯匿名）。"""
    if os.path.isfile(COOKIE_FILE):
        try:
            with open(COOKIE_FILE, "r", encoding="utf-8") as f:
                c = f.read().strip()
                if c:
                    return c
        except Exception:
            pass
    return ""


def http_request(url: str, headers: dict = None, method: str = "GET", timeout: int = 8) -> bytes:
    h = {
        "User-Agent": USER_AGENT,
        "Referer": REFERER,
    }
    c = get_cookie()
    if c:
        h["Cookie"] = c
    if headers:
        h.update(headers)
    req = urllib.request.Request(url, headers=h, method=method)
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.read()


def resolve_b23_shortlink(url: str) -> str:
    """对 b23.tv 短链执行无跳转重定向捕获，直接从 302 Location 头获取真实 URL。"""
    class NoRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            return None

    opener = urllib.request.build_opener(NoRedirect)
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    try:
        with opener.open(req, timeout=5) as r:
            return r.geturl()
    except urllib.error.HTTPError as e:
        if e.code in (301, 302, 303, 307, 308):
            loc = e.headers.get("Location")
            if loc:
                return loc
    except Exception as e:
        log(f"解析短链失败: {e}")
    return url


def parse_video_input(raw: str) -> tuple[str, int]:
    """
    解析用户输入，兼容:
      - 纯 BV 号 (BV1xx411c7mD)
      - 纯 av 号 (av170001)
      - b23.tv 短链 (https://b23.tv/xxx)
      - 完整 Web 链接 (https://www.bilibili.com/video/BV.../?p=2)
      - 手机 App 复制的长文本 (含前缀中文及短链)
    返回: (bvid_or_avid, p_number)
    """
    raw = raw.strip().strip("'\"")
    # 提取短链并重定向
    m_b23 = re.search(r"https?://b23\.tv/[A-Za-z0-9]+", raw)
    if m_b23:
        raw = resolve_b23_shortlink(m_b23.group(0))

    # 提取 P 分数 (如 ?p=2 或 &p=2)
    p_num = 1
    m_p = re.search(r"[?&]p=(\d+)", raw)
    if m_p:
        try:
            p_num = max(1, int(m_p.group(1)))
        except ValueError:
            pass

    # 提取 BV 号 (BV + 10位大小写字母数字)
    m_bv = re.search(r"\b(BV[0-9A-Za-z]{10})\b", raw)
    if m_bv:
        return m_bv.group(1), p_num

    # 提取 av 号 (av + 数字)
    m_av = re.search(r"\bav(\d+)\b", raw, re.I)
    if m_av:
        return f"av{m_av.group(1)}", p_num

    return raw, p_num


def get_mixin_key(orig: str) -> str:
    return reduce(lambda s, i: s + orig[i], MIXIN_KEY_ENC_TAB, "")[:32]


def get_wbi_keys() -> tuple[str, str]:
    """获取 WBI 鉴权密钥 (带本地 6 小时文件缓存，失效自动重刷)。"""
    now = time.time()
    if os.path.isfile(KEY_CACHE_FILE):
        try:
            with open(KEY_CACHE_FILE, "r", encoding="utf-8") as f:
                d = json.load(f)
                if now - d.get("ts", 0) < 21600:
                    return d["img_key"], d["sub_key"]
        except Exception:
            pass

    try:
        body = http_request("https://api.bilibili.com/x/web-interface/nav", timeout=6)
        data = json.loads(body.decode("utf-8"))
        wbi_img = data["data"]["wbi_img"]
        img_key = wbi_img["img_url"].rsplit("/", 1)[1].split(".")[0]
        sub_key = wbi_img["sub_url"].rsplit("/", 1)[1].split(".")[0]
        with open(KEY_CACHE_FILE, "w", encoding="utf-8") as f:
            json.dump({"img_key": img_key, "sub_key": sub_key, "ts": now}, f)
        return img_key, sub_key
    except Exception as e:
        log(f"获取 WBI 密钥失败: {e}，使用兜底密钥")
        return "7cd084941338484a827105e25f68485c", "4932caff0ff746eab6f01bf08b70ac45"


def enc_wbi(params: dict, img_key: str, sub_key: str) -> dict:
    mixin_key = get_mixin_key(img_key + sub_key)
    params["wts"] = round(time.time())
    params = dict(sorted(params.items()))
    params = {k: "".join(filter(lambda c: c not in "!'()*", str(v))) for k, v in params.items()}
    query = urllib.parse.urlencode(params)
    wbi_sign = md5((query + mixin_key).encode("utf-8")).hexdigest()
    params["w_rid"] = wbi_sign
    return params


def get_pagelist(bvid: str) -> list[dict]:
    """通过 x/player/pagelist 提取分 P 信息与 cid (完全不受 412 限制)。"""
    url = f"https://api.bilibili.com/x/player/pagelist?bvid={bvid}"
    body = http_request(url, timeout=6)
    data = json.loads(body.decode("utf-8"))
    if data.get("code") != 0:
        die(f"获取视频分P失败: {data.get('message')} (bvid={bvid})", 22)
    return data.get("data", [])


def is_bad_cdn(url: str) -> bool:
    """判断是否为易断连的 PCDN / MCDN / 边缘节点。"""
    if not url:
        return True
    parsed = urllib.parse.urlparse(url)
    host = parsed.netloc.lower()
    if "mcdn" in host or "pcdn" in host or "szbdyd" in host:
        return True
    if ":" in host and not host.endswith(":443") and not host.endswith(":80"):
        return True
    if "os=mcdn" in parsed.query:
        return True
    return False


def get_playurl(bvid: str, cid: int) -> tuple[str, int, int]:
    """提取 DASH 纯音频 CDN URL 与有效时长、音频总时长(秒)。"""
    img_key, sub_key = get_wbi_keys()
    params = {
        "bvid": bvid,
        "cid": cid,
        "fnval": 16,   # DASH 协议
        "fnver": 0,
        "fourk": 1
    }
    signed_p = enc_wbi(params, img_key, sub_key)
    url = "https://api.bilibili.com/x/player/wbi/playurl?" + urllib.parse.urlencode(signed_p)
    body = http_request(url, timeout=8)
    data = json.loads(body.decode("utf-8"))

    if data.get("code") != 0:
        # 若报签名错误，强制刷新密钥重试一次
        if os.path.isfile(KEY_CACHE_FILE):
            os.remove(KEY_CACHE_FILE)
        img_key, sub_key = get_wbi_keys()
        signed_p = enc_wbi(params, img_key, sub_key)
        url = "https://api.bilibili.com/x/player/wbi/playurl?" + urllib.parse.urlencode(signed_p)
        body = http_request(url, timeout=8)
        data = json.loads(body.decode("utf-8"))

    if data.get("code") != 0:
        die(f"获取播放地址失败: {data.get('message')} (code={data.get('code')})", 22)

    play_data = data.get("data", {})
    dash = play_data.get("dash")
    if not dash or not dash.get("audio"):
        die("该视频无可用 DASH 音频轨道", 22)

    # 优先选取码率最高或可用的音频轨道
    audios = dash["audio"]
    # 按 bandwidth 降序排序
    audios.sort(key=lambda a: a.get("bandwidth", 0), reverse=True)
    best_audio = audios[0]

    # 核心优化: 优先选取官方优质骨干 UPOS CDN，主动避开容易断流超时的 PCDN/MCDN
    candidates = []
    if best_audio.get("baseUrl"):
        candidates.append(best_audio["baseUrl"])
    candidates.extend(best_audio.get("backupUrl") or [])

    audio_url = ""
    for c in candidates:
        if not is_bad_cdn(c):
            audio_url = c
            break
    if not audio_url and candidates:
        audio_url = candidates[0]

    if not audio_url:
        die("无法获取音频流直链", 22)

    # 提取总音频时长 (毫秒转秒)
    duration_sec = int(play_data.get("timelength", 0)) // 1000

    # 从 URL 中提取 deadline 或默认 7200 秒
    deadline_sec = 7200
    try:
        qs = urllib.parse.parse_qs(urllib.parse.urlparse(audio_url).query)
        if "deadline" in qs:
            deadline_sec = max(300, int(qs["deadline"][0]) - int(time.time()))
    except Exception:
        pass

    return audio_url, deadline_sec, duration_sec


