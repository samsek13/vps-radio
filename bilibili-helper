def cmd_list_video(args: list[str]):
    if not args:
        die("用法: bilibili-helper list video <BV号/链接/文案> [p序号]", 24)
    raw = args[0]
    spec_p = int(args[1]) if len(args) > 1 and args[1].isdigit() else None

    bvid, p_num = parse_video_input(raw)
    if spec_p is not None:
        p_num = spec_p

    pages = get_pagelist(bvid)
    if not pages:
        die(f"视频无分P内容: {bvid}", 22)

    # 如果只有 1 P 或者指定了具体 P，只输出单条
    if len(pages) == 1:
        p = pages[0]
        title = clean_title(p.get("part") or bvid)
        print(f"{bvid}:{p['cid']} {title}")
    elif spec_p is not None:
        idx = max(0, min(len(pages) - 1, p_num - 1))
        p = pages[idx]
        title = clean_title(f"P{idx+1} {p.get('part') or bvid}")
        print(f"{bvid}:{p['cid']} {title}")
    else:
        # 多 P 且未指定具体 P：输出全部 P 作为歌单
        for i, p in enumerate(pages):
            title = clean_title(f"P{i+1} {p.get('part') or bvid}")
            print(f"{bvid}:{p['cid']} {title}")


def cmd_list_fav(args: list[str]):
    if not args:
        die("用法: bilibili-helper list fav <收藏夹ID或链接>", 24)
    raw = args[0].strip().strip("'\"")
    m_fid = re.search(r"(?:fid=|media_id=|ml|favorites/)(\d+)", raw)
    if m_fid:
        fid = m_fid.group(1)
    else:
        m_num = re.search(r"\b(\d+)\b", raw)
        if m_num:
            fid = m_num.group(1)
        else:
            die(f"无法识别收藏夹 ID: {raw}", 24)

    all_medias = []
    pn = 1
    while True:
        url = f"https://api.bilibili.com/x/v3/fav/resource/list?media_id={fid}&pn={pn}&ps=40"
        body = http_request(url, timeout=8)
        data = json.loads(body.decode("utf-8"))
        if data.get("code") != 0:
            if pn == 1:
                die(f"读取收藏夹失败: {data.get('message')} (fid={fid})", 22)
            break

        medias = data.get("data", {}).get("medias", [])
        if not medias:
            if pn == 1:
                die("收藏夹为空或为私密收藏夹 (私密收藏夹需在 Cookie 文件中配置 SESSDATA)", 22)
            break

        all_medias.extend(medias)
        has_more = data.get("data", {}).get("has_more", False)
        if not has_more or len(medias) < 40 or pn >= 25:
            break
        pn += 1

    for item in all_medias:
        bvid = item.get("bvid")
        title = clean_title(item.get("title"))
        # 收藏夹视频通过 bvid 取默认 cid
        print(f"{bvid} {title}")


def cmd_list_season(args: list[str]):
    if not args:
        die("用法: bilibili-helper list season <合集ID或链接> [mid]", 24)
    raw = args[0].strip().strip("'\"")

    # 提取 mid (若有)
    mid = args[1].strip().strip("'\"") if len(args) > 1 and args[1].strip().strip("'\"").isdigit() else "0"
    if mid == "0":
        m_mid = re.search(r"space\.bilibili\.com/(\d+)", raw)
        if m_mid:
            mid = m_mid.group(1)

    # 提取 season_id / series_id
    m_sid = re.search(r"(?:season_id=|sid=|series_id=|series/)(\d+)", raw)
    if m_sid:
        season_id = m_sid.group(1)
    else:
        # 没有显式 key 时，提取数字，注意避开 mid
        nums = re.findall(r"\b(\d+)\b", raw)
        candidates = [n for n in nums if n != mid]
        if candidates:
            season_id = candidates[0]
        elif nums:
            season_id = nums[0]
        else:
            die(f"无法识别合集 ID: {raw}", 24)

    all_archives = []
    # 策略 1: 尝试合集接口 seasons_archives_list (支持分页取全)
    page = 1
    while True:
        url = f"https://api.bilibili.com/x/polymer/web-space/seasons_archives_list?mid={mid}&season_id={season_id}&page_num={page}&page_size=40"
        try:
            body = http_request(url, timeout=8)
            data = json.loads(body.decode("utf-8"))
        except Exception as e:
            if page == 1:
                log(f"seasons_archives_list 请求异常: {e}")
            break

        if data.get("code") != 0:
            break

        archives = data.get("data", {}).get("archives", [])
        if not archives:
            break

        all_archives.extend(archives)
        total = data.get("data", {}).get("page", {}).get("total", 0)
        if len(all_archives) >= total or len(archives) < 40 or page >= 25:
            break
        page += 1

    # 策略 2: 若合集接口无数据，尝试系列接口 series/archives (支持分页取全)
    if not all_archives:
        page = 1
        while True:
            url = f"https://api.bilibili.com/x/series/archives?mid={mid}&series_id={season_id}&only_normal=true&sort=asc&pn={page}&ps=40"
            try:
                body = http_request(url, timeout=8)
                data = json.loads(body.decode("utf-8"))
            except Exception as e:
                if page == 1:
                    log(f"series/archives 请求异常: {e}")
                break

            if data.get("code") != 0:
                break

            archives = data.get("data", {}).get("archives", [])
            if not archives:
                break

            all_archives.extend(archives)
            total = data.get("data", {}).get("page", {}).get("total", 0)
            if len(all_archives) >= total or len(archives) < 40 or page >= 25:
                break
            page += 1

    if not all_archives:
        die(f"合集为空或不存在 (season_id={season_id}, mid={mid})", 22)

    for arc in all_archives:
        bvid = arc.get("bvid")
        title = clean_title(arc.get("title"))
        print(f"{bvid} {title}")


def cmd_search(args: list[str]):
    if not args:
        die("用法: bilibili-helper search <关键词>", 24)
    kw = " ".join(args).strip()

    img_key, sub_key = get_wbi_keys()
    signed_p = enc_wbi({"keyword": kw}, img_key, sub_key)
    url = "https://api.bilibili.com/x/web-interface/wbi/search/all/v2?" + urllib.parse.urlencode(signed_p)

    try:
        body = http_request(url, timeout=8)
        data = json.loads(body.decode("utf-8"))
    except Exception as e:
        die(f"搜索请求异常: {e}", 23)

    if data.get("code") != 0:
        die(f"搜索接口返回错误: {data.get('message')} (code={data.get('code')})", 23)

    v_list = []
    for r in data.get("data", {}).get("result", []):
        if r.get("result_type") == "video":
            v_list = r.get("data", [])
            break

    if not v_list:
        die(f"未找到关于 '{kw}' 的视频", 22)

    print(f"B站视频搜索结果 (共 {len(v_list)} 条):")
    cache_lines = []
    for i, v in enumerate(v_list[:20], 1):
        bvid = v.get("bvid")
        title = clean_title(v.get("title"))
        author = v.get("author", "未知UP")
        dur = v.get("duration", "--:--")
        print(f"{i:3d}. {title} — {author} ({dur})")
        cache_lines.append(f"{bvid} {title}\n")

    # 写入缓存文件 (支持跨文件系统拷贝并设为 666 权限)
    import shutil
    tmp_path = f"/tmp/bili-search.{os.getpid()}"
    try:
        with open(tmp_path, "w", encoding="utf-8") as f:
            f.writelines(cache_lines)
        os.chmod(tmp_path, 0o666)
        shutil.copyfile(tmp_path, SEARCH_CACHE)
        try:
            os.chmod(SEARCH_CACHE, 0o666)
        except OSError:
            pass
        os.remove(tmp_path)
        print("播放: radioctl bilibili play <序号> (从 1 起)")
    except Exception as e:
        if os.path.exists(tmp_path):
            os.remove(tmp_path)
        log(f"警告: 搜索缓存写入失败: {e}")


def cmd_list_search_cache():
    if not os.path.isfile(SEARCH_CACHE):
        die("搜索缓存不存在, 请先执行 radioctl bilibili search <关键词>", 24)
    with open(SEARCH_CACHE, "r", encoding="utf-8") as f:
        sys.stdout.write(f.read())


def cmd_stream(args: list[str]):
    if not args:
        die("用法: bilibili-helper stream <bvid[:cid]> [target_fifo] [start_time]", 24)
    target = args[0].strip().strip("'\"")
    fifo = args[1].strip().strip("'\"") if len(args) > 1 else "/run/radiod/audio.fifo"
    ss = args[2].strip().strip("'\"") if len(args) > 2 else ""

    # 解析 target
    if ":" in target:
        bvid, cid_str = target.split(":", 1)
        cid = int(cid_str) if cid_str.isdigit() else 0
    else:
        bvid, _ = parse_video_input(target)
        cid = 0

    # 若未指定具体 cid，查一次 pagelist
    if not cid:
        pages = get_pagelist(bvid)
        if not pages:
            die(f"未能获取视频分P: {bvid}", 22)
        cid = pages[0]["cid"]

    audio_url, deadline_sec, total_duration = get_playurl(bvid, cid)
    hdr = f"Referer: {REFERER}\r\nUser-Agent: {USER_AGENT}\r\n"

    # 解析起始偏移秒数
    start_sec = 0
    if ss:
        parts = ss.split(":")
        try:
            if len(parts) == 1:
                start_sec = float(parts[0])
            elif len(parts) == 2:
                start_sec = int(parts[0]) * 60 + float(parts[1])
            elif len(parts) == 3:
                start_sec = int(parts[0]) * 3600 + int(parts[1]) * 60 + float(parts[2])
        except ValueError:
            start_sec = 0

    # 常规曲目 (<= 7000s ≈ 1.94h): 直接 exec ffmpeg，0 进程监管开销，完美保持 PID
    # 增加 -reconnect 1 -reconnect_streamed 1 -reconnect_delay_max 5 保证 HTTP 抖动不断播
    if 0 < total_duration <= 7000 and deadline_sec > 600:
        cmd = [
            "ffmpeg",
            "-hide_banner", "-loglevel", "warning", "-nostdin", "-y",
            "-rw_timeout", "15000000",
            "-reconnect", "1",
            "-reconnect_streamed", "1",
            "-reconnect_delay_max", "5",
            "-headers", hdr,
        ]
        if ss:
            cmd.extend(["-ss", ss])
        cmd.extend([
            "-i", audio_url,
            "-vn", "-map", "0:a:0",
            "-ac", "2", "-ar", "44100", "-f", "s16le",
            fifo
        ])
        os.execvp("ffmpeg", cmd)

    # 超长音频 (>2h 或未知时长): 启动 Supervisor 监听，断连自动带 -ss 秒级续播
    log(f"启动超长音频断点接力守护 (duration={total_duration}s, token_valid={deadline_sec}s, start_offset={start_sec}s)")
    current_offset = int(start_sec)

    while True:
        cmd = [
            "ffmpeg",
            "-hide_banner", "-loglevel", "warning", "-nostdin", "-y",
            "-rw_timeout", "15000000",
            "-reconnect", "1",
            "-reconnect_streamed", "1",
            "-reconnect_delay_max", "5",
            "-headers", hdr,
        ]
        if current_offset > 0:
            cmd.extend(["-ss", str(current_offset)])
        cmd.extend([
            "-i", audio_url,
            "-vn", "-map", "0:a:0",
            "-ac", "2", "-ar", "44100", "-f", "s16le",
            fifo
        ])

        start_ts = time.time()
        proc = subprocess.Popen(cmd)

        def handle_signal(sig, frame):
            proc.terminate()
            sys.exit(0)

        signal.signal(signal.SIGTERM, handle_signal)
        signal.signal(signal.SIGINT, handle_signal)

        ret = proc.wait()
        elapsed = time.time() - start_ts
        current_offset += int(elapsed)

        # 正常播放完毕判定: 达到总时长末尾 或 (未知时长且正常退出)
        if (total_duration > 0 and current_offset >= total_duration - 5) or (total_duration == 0 and ret == 0):
            sys.exit(0)

        # 运行少于 3 秒崩溃，判定为无法继续播放，避免快速死循环
        if elapsed < 3:
            log(f"上游持续失败 (已播 {current_offset}s, 退出码 {ret}), 停止接力")
            sys.exit(ret if ret != 0 else 22)

        # 非正常中断且未播完，申请新 Token 接力续播
        log(f"上游连接中断于 {current_offset}s (目标总长 {total_duration}s)，正在申请新 Token 断点接力...")
        try:
            audio_url, _, _ = get_playurl(bvid, cid)
            time.sleep(0.3)
        except Exception as e:
            log(f"接力续播换链失败: {e}")
            sys.exit(ret if ret != 0 else 22)


def main():
    if len(sys.argv) < 2:
        print("bilibili-helper — Bilibili 音源辅助工具")
        print("用法:")
        print("  bilibili-helper list video <BV号/链接> [p]   列出单视频或分P")
        print("  bilibili-helper list fav <收藏夹ID/链接>      列出公开收藏夹")
        print("  bilibili-helper list season <合集ID/链接>     列出UP主合集")
        print("  bilibili-helper list search-cache             输出上次搜索缓存")
        print("  bilibili-helper search <关键词...>            搜索单曲视频")
        print("  bilibili-helper stream <bvid[:cid]> [fifo]    提取音频推流至 FIFO")
        sys.exit(0)

    sub = sys.argv[1]
    args = sys.argv[2:]

    if sub == "list":
        if not args:
            die("list 需要子参数: video | fav | season | search-cache", 24)
        target = args[0]
        if target == "video":
            cmd_list_video(args[1:])
        elif target == "fav":
            cmd_list_fav(args[1:])
        elif target == "season":
            cmd_list_season(args[1:])
        elif target in ("search-cache", "search"):
            cmd_list_search_cache()
        else:
            die(f"未知的 list 类别: {target}", 24)
    elif sub == "search":
        cmd_search(args)
    elif sub == "stream":
        cmd_stream(args)
    else:
        die(f"未知命令: {sub}", 24)


if __name__ == "__main__":
    main()
