def radio_status():
    st = {
        "radiod": service_active("radiod"),
        "mediamtx": service_active("mediamtx"),
        "caddy": service_active("caddy"),
        "ncm-api": service_active("ncm-api"),
        "volume": get_volume(),
    }
    try:
        fields = STATE_FILE.read_text().strip().split("|")
        st["source"] = {
            "name": fields[0] if len(fields) > 0 else "unknown",
            "dir": fields[1] if len(fields) > 1 else "",
            "file": fields[2] if len(fields) > 2 else "",
            "idx": int(fields[3]) if len(fields) > 3 and fields[3].isdigit() else 0,
            "total": int(fields[4]) if len(fields) > 4 and fields[4].isdigit() else 0,
            "order": fields[5] if len(fields) > 5 else "",
            "ts": int(fields[6]) if len(fields) > 6 and fields[6].isdigit() else 0,
        }
    except (OSError, ValueError):
        st["source"] = None
    try:
        st["netease_logged_in"] = "MUSIC_U=" in NETEASE_COOKIE.read_text()
    except OSError:
        st["netease_logged_in"] = False
    try:
        sp_cfg = json.loads(SPOTIFY_AUTH_FILE.read_text())
        st["spotify_auth_ready"] = bool(sp_cfg.get("client_id") and sp_cfg.get("refresh_token"))
    except Exception:
        st["spotify_auth_ready"] = False
    # 最近一次控制命令的处理结果 (radiod 写 cmd.result: "<ts>|<OK|FAIL>|<文本>")。
    # 面板轮询 status 时展示 → 点播"命令送达但没播成"不再静默 (2026-09-15 搜索点歌 bug 的可见化)
    st["last_cmd"] = None
    try:
        last = CMD_RESULT_FILE.read_text().strip().splitlines()[-1]
        ts, _, rest = last.partition("|")
        status, _, text = rest.partition("|")
        if ts.isdigit():
            st["last_cmd"] = {"ts": int(ts), "status": status, "text": text.strip()}
    except (OSError, IndexError):
        pass
    return st


def library():
    out = []
    for p in sorted(MEDIA_DIR.rglob("*")):
        if p.is_file():
            stat = p.stat()
            out.append({"name": p.name, "path": str(p), "size": stat.st_size, "mtime": int(stat.st_mtime)})
    return {"files": out}


