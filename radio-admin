    def api_netease_qr(self):
        """helper login-qr-url → PNG 二维码 + unikey 头"""
        try:
            r = subprocess.run([HELPER, "login-qr-url"], capture_output=True, text=True, timeout=15)
        except (subprocess.TimeoutExpired, OSError) as e:
            return self._json(502, {"error": f"qr failed: {e}"})
        if r.returncode != 0:
            return self._json(502, {"error": (r.stderr or "login-qr-url failed").strip()[:300]})
        lines = [l for l in r.stdout.splitlines() if l.strip()]
        if len(lines) < 2:
            return self._json(502, {"error": "qr output malformed"})
        key, url = lines[0], lines[1]
        png = subprocess.run(
            ["qrencode", "-t", "PNG", "-o", "-", "-s", "6", url],
            capture_output=True, timeout=10,
        )
        if png.returncode != 0 or not png.stdout:
            return self._json(502, {"error": "qrencode failed"})
        self._bytes(200, png.stdout, "image/png", {"X-QR-Key": key})

    def api_netease_login_check(self):
        m = re.search(r"[?&]key=([^&]+)", self.path)
        if not m:
            return self._json(400, {"error": "missing key"})
        key = m.group(1)
        try:
            r = subprocess.run([HELPER, "login-check", key], capture_output=True, text=True, timeout=15)
        except (subprocess.TimeoutExpired, OSError) as e:
            return self._json(502, {"error": f"check failed: {e}"})
        # rc: 0=803 成功 / 1=等待(801/802) / 24=过期
        if r.returncode == 0:
            self._json(200, {"code": 803, "message": "登录成功"})
        elif r.returncode == 24:
            self._json(200, {"code": 800, "message": "二维码已过期"})
        elif r.returncode == 1:
            code = r.stdout.strip() or "801"
            self._json(200, {"code": int(code) if code.isdigit() else 801, "message": "waiting"})
        else:
            self._json(502, {"error": (r.stderr or r.stdout or "check failed").strip()[:300]})


    def api_spotify_auth(self):
        req = self._read_json() or {}
        action = req.get("action", "")
        if action == "set":
            cid = req.get("client_id", "").strip()
            csec = req.get("client_secret", "").strip()
            refresh = req.get("refresh_token", "").strip()
            if not cid or not csec or not refresh:
                return self._json(400, {"error": "client_id, client_secret, refresh_token 均不能为空"})
            r = subprocess.run([str(SPOTIFY_HELPER), "auth-set", cid, csec, refresh], capture_output=True, text=True, timeout=15)
            if r.returncode == 0:
                return self._json(200, {"ok": True, "msg": "Spotify 凭据已保存并验证成功"})
            else:
                return self._json(400, {"error": (r.stderr or r.stdout or "验证失败").strip()[:300]})
        elif action == "exchange":
            code = req.get("code", "").strip()
            cid = req.get("client_id", "").strip()
            csec = req.get("client_secret", "").strip()
            ruri = req.get("redirect_uri", "").strip() or "https://localhost:8888/callback"
            if not code or not cid or not csec:
                return self._json(400, {"error": "code, client_id, client_secret 不能为空"})
            r = subprocess.run([str(SPOTIFY_HELPER), "auth-exchange", code, cid, csec, ruri], capture_output=True, text=True, timeout=15)
            if r.returncode == 0:
                return self._json(200, {"ok": True, "msg": "Spotify 授权成功并已保存"})
            else:
                return self._json(400, {"error": (r.stderr or r.stdout or "交换 Token 失败").strip()[:300]})
        elif action == "url":
            cid = req.get("client_id", "").strip()
            ruri = req.get("redirect_uri", "").strip() or "https://localhost:8888/callback"
            if not cid:
                return self._json(400, {"error": "client_id 不能为空"})
            r = subprocess.run([str(SPOTIFY_HELPER), "auth-url", cid, ruri], capture_output=True, text=True, timeout=10)
            if r.returncode == 0:
                return self._json(200, {"url": r.stdout.strip()})
            else:
                return self._json(400, {"error": (r.stderr or "生成授权 URL 失败").strip()[:300]})
        else:
            self._json(400, {"error": f"未知 action: {action}"})


