def _get_json(url: str, headers: dict | None = None, timeout: int = 3):
    req = urllib.request.Request(url, headers=headers or {})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read())


def _cover(key: str, fetch) -> str | None:
    if key in _cover_cache:
        return _cover_cache[key]
    try:
        url = fetch()
    except Exception:
        url = None
    _cover_cache[key] = url
    return url


def netease_cover(song_id: str) -> str | None:
    if not song_id.isdigit():
        return None
    def f():
        j = _get_json(f"{NCM_DETAIL}?id={song_id}&ids=[{song_id}]", NCM_HEADERS)
        s = (j.get("songs") or [{}])[0]
        al = s.get("al") or s.get("album") or {}
        return al.get("picUrl")
    return _cover(f"ne:{song_id}", f)


def soundcloud_cover(track_id: str) -> str | None:
    if not track_id.isdigit():
        return None
    def f():
        j = _get_json(f"https://api-v2.soundcloud.com/tracks/{track_id}?client_id={get_soundcloud_cid()}")
        art = j.get("artwork_url") or (j.get("user") or {}).get("avatar_url")
        return art.replace("-large", "-t500x500") if art else None
    return _cover(f"sc:{track_id}", f)


def np_cover(src: dict) -> str | None:
    fid = (src.get("file") or "").split(" ", 1)[0]
    if src.get("name") == "netease":
        return netease_cover(fid)
    if src.get("name") == "soundcloud":
        return soundcloud_cover(fid)
    return None


