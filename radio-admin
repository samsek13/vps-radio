def get_volume() -> float:
    try:
        val = float(VOL_FILE.read_text().strip())
        return round(val, 2)
    except (OSError, ValueError):
        return 1.0

def send_zmq_volume(vol: float) -> tuple[bool, str]:
    try:
        import zmq
        ctx = zmq.Context.instance()
        sock = ctx.socket(zmq.REQ)
        sock.setsockopt(zmq.RCVTIMEO, 2000)
        sock.setsockopt(zmq.SNDTIMEO, 2000)
        sock.setsockopt(zmq.LINGER, 500)
        sock.connect(ZMQ_ADDR)
        sock.send_string(f"volume@vol volume {vol}")
        reply = sock.recv_string()
        sock.close()
        if "Success" in reply or reply.startswith("0"):
            return True, "ok"
        return False, reply
    except Exception as e:
        return False, str(e)


