#!/usr/bin/env bash
# radioctl — VPS Radio 控制工具
# 依赖 radiod 主脚本在跑 (systemd 拉起时才有 /run/radiod/cmd.fifo)
# 用法:
#   radioctl status                      # 当前音源/曲目/进度/播放列表状态
#   radioctl mode [repeat|loop|seq|shuffle] # 切换模式 (单曲|循环|顺序|随机)
#   radioctl spotify                     # 切到 Spotify (手机上一按播放即出声)
#   radioctl file <绝对路径> [时点]        # 切到本地音频文件 (单曲无限循环，支持指定起始时点)
#   radioctl folder [目录] [repeat|loop|seq|shuffle]  # 文件夹循环播放 (默认媒体库, 默认列表循环)
#   radioctl netease login                # 网易云扫码登录 (二维码打终端)
#   radioctl netease status               # 网易云登录态 (昵称/VIP)
#   radioctl netease song <歌曲id或链接> [模式] # 网易云单曲点播
#   radioctl netease playlist <歌单id或分享链接/文字> [模式]   # 网易云歌单循环
#   radioctl netease album <专辑id或分享链接/文字> [模式]       # 网易云专辑循环
#   radioctl netease podcast [播客id/链接] [模式] # 网易云播客循环 (无参列出已订阅)
#   radioctl netease podcasts             # 列出已订阅播客
#   radioctl netease podcast-sub <序号> [模式]   # 播放已订阅播客的第 n 个
#   radioctl netease program <节目id/链接> [模式] # 播客单集播放
#   radioctl netease fm                   # 网易云私人FM
#   radioctl netease daily                # 网易云每日推荐
#   radioctl netease search <关键词>      # 搜索单曲 (编号列表)
#   radioctl netease play <序号> [模式]   # 播放上次搜索结果的第 n 首 (默认单曲循环)
#   radioctl netease podcast-search <关键词> # 搜索播客 (编号列表)
#   radioctl netease podcast-play <序号>  # 播放上次播客搜索结果的第 n 个
#   radioctl soundcloud status            # SoundCloud CID 健康检查 (金丝钱探针)
#   radioctl soundcloud track <单曲id或链接> [模式] # SoundCloud 单曲点播
#   radioctl soundcloud likes [用户名/链接] [模式] # 播放用户 likes (默认 plusdrei)
#   radioctl soundcloud playlist <歌单id或完整链接> [模式] # 播放 SC 歌单 (支持直接贴 URL)
#   radioctl soundcloud search <关键词>   # 搜索 (编号列表, ✂=30s试听)
#   radioctl soundcloud play <序号> [模式] # 播放上次搜索结果的第 n 首 (默认单曲循环)
#   radioctl bilibili video <BV或链接> [p] [模式] # B站单视频或分P
#   radioctl bilibili fav <收藏夹id或链接> [模式] # B站公开收藏夹循环
#   radioctl bilibili season <合集id或链接> [模式] # B站UP主合集循环
#   radioctl bilibili search <关键词>     # B站视频搜索 (编号列表)
#   radioctl bilibili play <序号> [模式]  # 播放上次B站搜索结果的第 n 首
#   radioctl youtube [链接/ID] [模式]     # YouTube 智能点播 (自动识别视频/歌单)
#   radioctl youtube video <链接/ID> [模式] # YouTube 单视频点播
#   radioctl youtube playlist <链接/ID> [模式] # YouTube 歌单点播
#   radioctl youtube search <关键词>      # YouTube 视频搜索 (编号列表)
#   radioctl youtube play <序号> [模式]   # 播放上次 YouTube 搜索结果的第 n 首
#   radioctl bandcamp [链接] [模式]       # Bandcamp 智能点播 (自动识别单曲/专辑/艺人)
#   radioctl bandcamp track <链接> [模式] # Bandcamp 单曲点播
#   radioctl bandcamp album <链接> [模式] # Bandcamp 专辑循环
#   radioctl bandcamp artist <链接> [模式] # Bandcamp 艺人全库循环
#   radioctl bandcamp search <关键词>     # Bandcamp 搜索 (编号列表)
#   radioctl bandcamp play <序号> [模式]  # 播放上次 Bandcamp 搜索结果的第 n 项
#   radioctl skip                        # folder/netease/soundcloud/bilibili/youtube/bandcamp=跳到下一首, file=单曲重头播
#   radioctl seek <时点>                 # 从指定时点播放当前曲目 (如 01:30 或 90)
#   radioctl volume [倍数]               # 查看或设置音量放大倍数 (如 1.5)
#   radioctl ls                          # 列出媒体库 (/var/lib/radiod/media)
#   radioctl upload-hint                 # 提示 scp 命令行
set -uo pipefail

CMD_FIFO="/run/radiod/cmd.fifo"
STATE_FILE="/run/radiod/source.state"
CMD_RESULT="/run/radiod/cmd.result"   # radiod 写的最近命令处理结果 (status 末行展示)
MEDIA_DIR="/var/lib/radiod/media"
NETEASE_HELPER="/usr/local/bin/netease-helper"
SEARCH_CACHE="/run/radiod/netease_search.cache"
PODCAST_SEARCH_CACHE="/run/radiod/netease_podcast_search.cache"
SC_HELPER="/usr/local/bin/soundcloud-helper"
SC_SEARCH_CACHE="/run/radiod/soundcloud_search.cache"
SC_DEFAULT_LIKES="plusdrei"       # "radioctl soundcloud likes" 不带参数时用
BILI_HELPER="/usr/local/bin/bilibili-helper"
BILI_SEARCH_CACHE="/run/radiod/bilibili_search.cache"
YT_HELPER="/usr/local/bin/youtube-helper"
YT_SEARCH_CACHE="/run/radiod/youtube_search.cache"
BC_HELPER="/usr/local/bin/bandcamp-helper"
BC_SEARCH_CACHE="/run/radiod/bandcamp_search.cache"

usage() { sed -n '2,51p' "$0"; exit "${1:-0}"; }

send() {  # 往命令 FIFO 写一行; 无 FIFO 时给出可操作提示
    if [ ! -p "$CMD_FIFO" ]; then
        echo "radiod 未在运行 (无 $CMD_FIFO)。请先: sudo systemctl start radiod" >&2
        exit 1
    fi
    printf '%s\n' "$1" > "$CMD_FIFO" || { echo "写入命令失败" >&2; exit 1; }
}

# 绝对路径化 (radioctl 预检需要; 处理空格由协议端保证)
abspath() {
    case "$1" in
        /*) printf '%s' "$1" ;;
        *)  printf '%s' "$(cd "$(dirname "$1")" && pwd)/$(basename "$1")" ;;
    esac
}

case "${1:-status}" in
    status)
        if [ -r "$STATE_FILE" ]; then
            IFS='|' read -r name dir file idx total order ts < "$STATE_FILE"
            ago=$(( $(date +%s) - ts ))
            case "$name" in
                spotify) echo "当前音源: spotify (VPS Radio in Spotify Connect)" ;;
                file)
                    echo "当前音源: file — 单曲循环 $(basename "$file")"
                    echo "  $file"
                    ;;
                folder)
                    echo "当前音源: folder ($order) — $dir"
                    echo "  第 $((idx + 1))/$total 首: $(basename "$file")"
                    ;;
                netease)
                    ctx_pretty="$dir"
                    case "$dir" in
                        playlist:*) ctx_pretty="网易歌单 #${dir#playlist:}" ;;
                        album:*)    ctx_pretty="网易专辑 #${dir#album:}" ;;
                        podcast:*)  ctx_pretty="网易播客 #${dir#podcast:}" ;;
                        program:*)  ctx_pretty="网易节目 #${dir#program:}" ;;
                        song:*)     ctx_pretty="网易单曲 #${dir#song:}" ;;
                        fm)         ctx_pretty="私人FM" ;;
                        daily)      ctx_pretty="每日推荐" ;;
                        search)     ctx_pretty="搜索结果" ;;
                    esac
                    echo "当前音源: netease ($order) — $ctx_pretty"
                    echo "  第 $((idx + 1))/$total 首: ${file#* } (id=${file%% *})"
                    ;;
                soundcloud)
                    ctx_pretty="$dir"
                    case "$dir" in
                        likes:*)    ctx_pretty="Likes @${dir#likes:}" ;;
                        playlist:*) ctx_pretty="SC歌单 #${dir#playlist:}" ;;
                        track:*)    ctx_pretty="SC单曲 #${dir#track:}" ;;
                        search)     ctx_pretty="搜索点歌" ;;
                    esac
                    echo "当前音源: soundcloud ($order) — $ctx_pretty"
                    echo "  第 $((idx + 1))/$total 首: ${file#* } (id=${file%% *})"
                    ;;
                bilibili)
                    ctx_pretty="$dir"
                    case "$dir" in
                        video:*)    ctx_pretty="B站视频 #${dir#video:}" ;;
                        fav:*)      ctx_pretty="B站收藏夹 #${dir#fav:}" ;;
                        season:*)   ctx_pretty="B站合集 #${dir#season:}" ;;
                        search)     ctx_pretty="搜索点歌" ;;
                    esac
                    echo "当前音源: bilibili ($order) — $ctx_pretty"
                    echo "  第 $((idx + 1))/$total 首: ${file#* } (id=${file%% *})"
                    ;;
                youtube)
                    ctx_pretty="$dir"
                    case "$dir" in
                        video:*)    ctx_pretty="YouTube 视频 #${dir#video:}" ;;
                        playlist:*) ctx_pretty="YouTube 歌单 #${dir#playlist:}" ;;
                        search)     ctx_pretty="YouTube 搜索点歌" ;;
                    esac
                    echo "当前音源: youtube ($order) — $ctx_pretty"
                    echo "  第 $((idx + 1))/$total 首: ${file#* } (id=${file%% *})"
                    ;;
                bandcamp)
                    ctx_pretty="$dir"
                    case "$dir" in
                        album:*)    ctx_pretty="Bandcamp 专辑 #${dir#album:}" ;;
                        track:*)    ctx_pretty="Bandcamp 单曲 #${dir#track:}" ;;
                        artist:*)   ctx_pretty="Bandcamp 艺人 #${dir#artist:}" ;;
                        search:*)   ctx_pretty="Bandcamp 搜索点歌" ;;
                        search)     ctx_pretty="Bandcamp 搜索点歌" ;;
                    esac
                    echo "当前音源: bandcamp ($order) — $ctx_pretty"
                    echo "  第 $((idx + 1))/$total 首: ${file#* }"
                    ;;
                *) echo "当前音源: $name" ;;
            esac
            echo "状态更新于 ${ago}s 前"
            # 最近一次控制命令的处理结果 (radiod 写 /run/radiod/cmd.result: ts|OK/FAIL|文本)
            if [ -r "$CMD_RESULT" ]; then
                IFS='|' read -r _rts _rstatus _rtext < <(tail -1 "$CMD_RESULT")
                case "$_rts" in
                    ''|*[!0-9]*) : ;;   # 半行/坏行不显示
                    *) [ -n "$_rtext" ] && echo "最近操作 [$_rstatus] (约 $(( $(date +%s) - _rts ))s 前): $_rtext" ;;
                esac
            fi
        else
            echo "radiod 未运行 (无 $STATE_FILE)"
            exit 1
        fi
        ;;
    spotify)    send "switch-to-spotify" ;;
    file)
        [ $# -ge 2 ] || { echo "用法: radioctl file <绝对路径> [时点]" >&2; exit 1; }
        f="$(abspath "$2")"
        if [ ! -r "$f" ]; then
            echo "文件不可读: $f" >&2
            exit 1
        fi
        ss="${3:-}"
        if [ -n "$ss" ]; then
            send "switch-to-file $f $ss"
            echo "已切到文件: $f (从 $ss 开始)"
        else
            send "switch-to-file $f"
            echo "已切到文件: $f"
        fi
        ;;
    folder)
        d="${2:-$MEDIA_DIR}"
        ord="${3:-shuffle}"
        [ "$ord" = "seq" ] || ord="shuffle"
        d="$(abspath "$d")"
        if [ ! -d "$d" ]; then
            echo "目录不存在: $d" >&2
            exit 1
        fi
        # find 预检而非 ls+glob: 不匹配的 glob 会以字面量传给 ls 导致误报"无音频文件"
        if [ -z "$(find "$d" -maxdepth 1 -type f \( -iname '*.mp3' -o -iname '*.m4a' -o -iname '*.aac' -o -iname '*.flac' -o -iname '*.wav' -o -iname '*.ogg' -o -iname '*.opus' -o -iname '*.wma' \) -print -quit)" ]; then
            echo "目录里没有音频文件: $d" >&2
            exit 1
        fi
        send "switch-to-folder $d $ord"
        ;;
    netease)
        sub="${2:-}"; shift 2
        case "$sub" in
            login)  exec "$NETEASE_HELPER" login ;;
            status) exec "$NETEASE_HELPER" login-status ;;
            fm)     send "switch-to-netease fm" ;;
            daily)  send "switch-to-netease daily" ;;
            playlist|album)
                [ $# -ge 1 ] || { echo "用法: radioctl netease $sub <id或分享链接/文字> [shuffle|seq]" >&2; exit 1; }
                raw="$1"; ord="${2:-shuffle}"
                [ "$ord" = "seq" ] || ord="shuffle"
                id="$raw"
                if [[ ! "$id" =~ ^[0-9]+$ ]]; then
                    id=$(python3 -c "
import urllib.request, re, sys
text = sys.argv[1].strip()
m = re.search(r'https?://[^\s)）]+', text)
if m:
    u = m.group(0)
    m_id = re.search(r'[?&](?:id|rid)=(\d+)', u)
    if m_id and '163cn.tv' not in u and '163.fm' not in u:
        print(m_id.group(1)); sys.exit(0)
    try:
        req = urllib.request.Request(u, headers={'User-Agent': 'Mozilla/5.0'})
        with urllib.request.urlopen(req, timeout=10) as resp:
            fu = resp.geturl()
        m_id = re.search(r'[?&](?:id|rid)=(\d+)', fu) or re.search(r'/(?:playlist|album|program|song)/(\d+)', fu)
        if m_id: print(m_id.group(1)); sys.exit(0)
    except Exception: pass
m_id = re.search(r'(?:id|rid)=(\d+)', text)
if m_id: print(m_id.group(1)); sys.exit(0)
" "$raw" 2>/dev/null || true)
                fi
                case "$id" in ''|*[!0-9]*) echo "无法解析数字 ID (支持直接填 ID、完整链接或 App 分享文字): $raw" >&2; exit 1 ;; esac
                # 预检: 列表取得到才切换 (daemon 收到命令后还会自取一次)
                n=$("$NETEASE_HELPER" list "$sub" "$id" 2>/dev/null | grep -c .)
                [ "${n:-0}" -gt 0 ] || { echo "$sub #$id 取不到曲目 (id 错或接口异常, 详情: journalctl -u radiod -n 20)" >&2; exit 1; }
                echo "$sub #$id: $n 首 ($ord), 切换中 (journalctl -u radiod -f 看进度)"
                send "switch-to-netease $sub $id $ord"
                ;;
            podcast)
                if [ $# -eq 0 ]; then
                    "$NETEASE_HELPER" list podcasts || true
                    echo
                    echo "用法: radioctl netease podcast <播客ID或链接> [shuffle|seq]"
                    echo "      radioctl netease podcast-sub <序号> [shuffle|seq]  (播放上方订阅列表中的第 n 个)"
                    exit 0
                fi
                id="$1"; ord="${2:-seq}"
                [ "$ord" = "shuffle" ] || ord="seq"
                id=$(sed -E 's/.*[?&](id|rid)=([0-9]+).*/\2/; s/.*\/([0-9]+)$/\1/' <<<"$id")
                case "$id" in ''|*[!0-9]*) echo "播客 id 需为数字或链接: $1" >&2; exit 1 ;; esac
                n=$("$NETEASE_HELPER" list podcast "$id" 2>/dev/null | grep -c .)
                [ "${n:-0}" -gt 0 ] || { echo "播客 #$id 取不到曲目 (id 错或接口异常, 详情: journalctl -u radiod -n 20)" >&2; exit 1; }
                echo "播客 #$id: $n 期 ($ord), 切换中 (journalctl -u radiod -f 看进度)"
                send "switch-to-netease podcast $id $ord"
                ;;
            podcasts)
                "$NETEASE_HELPER" list podcasts
                ;;
            podcast-sub)
                if [ $# -eq 0 ]; then
                    "$NETEASE_HELPER" list podcasts
                    exit 0
                fi
                idx="$1"; ord="${2:-seq}"
                [ "$ord" = "shuffle" ] || ord="seq"
                case "$idx" in ''|*[!0-9]*) echo "序号需为数字: $idx" >&2; exit 1 ;; esac
                cookie=$(tr -d '\r\n' < /var/lib/radiod/netease_cookie 2>/dev/null || true)
                id=$(curl -s --max-time 10 "http://127.0.0.1:3000/dj/sublist?cookie=$(jq -rn --arg c "$cookie" '$c|@uri')" \
                    | jq -r ".djRadios[$((idx - 1))].id // empty" 2>/dev/null)
                [ -n "$id" ] || { echo "订阅序号 $idx 超出范围或未登录 (共可查已订阅播客: radioctl netease podcasts)" >&2; exit 1; }
                n=$("$NETEASE_HELPER" list podcast "$id" 2>/dev/null | grep -c .)
                [ "${n:-0}" -gt 0 ] || { echo "播客 #$id 取不到曲目" >&2; exit 1; }
                echo "已选订阅第 $idx 个播客 (#$id): $n 期 ($ord), 切换中..."
                send "switch-to-netease podcast $id $ord"
                ;;
            song)
                [ $# -ge 1 ] || { echo "用法: radioctl netease song <歌曲id或链接> [repeat|loop|seq|shuffle]" >&2; exit 1; }
                raw="$1"; ord="${2:-repeat}"
                id=$(sed -E 's/.*[?&](id|rid)=([0-9]+).*/\2/; s/.*\/([0-9]+)$/\1/' <<<"$raw")
                case "$id" in ''|*[!0-9]*) echo "歌曲 id 需为数字或链接: $raw" >&2; exit 1 ;; esac
                line=$("$NETEASE_HELPER" list song "$id" 2>/dev/null)
                [ -n "$line" ] || { echo "歌曲 #$id 不可用" >&2; exit 1; }
                echo "网易单曲 #$id: ${line#* }, 切换中 ($ord)..."
                send "switch-to-netease song $id $ord"
                ;;
            program)
                [ $# -ge 1 ] || { echo "用法: radioctl netease program <节目id或链接> [repeat|loop|seq|shuffle]" >&2; exit 1; }
                id="$1"; ord="${2:-repeat}"
                id=$(sed -E 's/.*[?&](id|rid)=([0-9]+).*/\2/; s/.*\/([0-9]+)$/\1/' <<<"$id")
                case "$id" in ''|*[!0-9]*) echo "节目 id 需为数字或链接: $1" >&2; exit 1 ;; esac
                line=$("$NETEASE_HELPER" list program "$id" 2>/dev/null)
                [ -n "$line" ] || { echo "节目 #$id 不可用 (详情: journalctl -u radiod -n 20)" >&2; exit 1; }
                echo "播客单集 #$id: ${line#* }, 切换中 ($ord)..."
                send "switch-to-netease program $id $ord"
                ;;
            search)
                [ $# -ge 1 ] || { echo "用法: radioctl netease search <关键词>" >&2; exit 1; }
                "$NETEASE_HELPER" search "$@"
                ;;
            play)
                [ "$#" -ge 1 ] || { echo "用法: radioctl netease play <序号> [repeat|loop|seq|shuffle]" >&2; exit 1; }
                idx="$1"; ord="${2:-repeat}"
                case "$idx" in ''|*[!0-9]*) echo "序号需为数字: $idx" >&2; exit 1 ;; esac
                [ -s "$SEARCH_CACHE" ] || { echo "无搜索缓存, 先 radioctl netease search <关键词>" >&2; exit 1; }
                total=$(grep -c . "$SEARCH_CACHE")
                [ "$idx" -le "$total" ] || { echo "序号超范围 (共 $total 条)" >&2; exit 1; }
                send "switch-to-netease search $(( idx - 1 )) $ord"
                ;;
            podcast-search|search-podcast)
                [ $# -ge 1 ] || { echo "用法: radioctl netease podcast-search <关键词>" >&2; exit 1; }
                "$NETEASE_HELPER" search-podcast "$@"
                ;;
            podcast-play|play-podcast)
                [ "$#" -ge 1 ] || { echo "用法: radioctl netease podcast-play <序号> [shuffle|seq]" >&2; exit 1; }
                idx="$1"; ord="${2:-seq}"
                [ "$ord" = "shuffle" ] || ord="seq"
                case "$idx" in ''|*[!0-9]*) echo "序号需为数字: $idx" >&2; exit 1 ;; esac
                [ -s "$PODCAST_SEARCH_CACHE" ] || { echo "无播客搜索缓存, 先 radioctl netease podcast-search <关键词>" >&2; exit 1; }
                total=$(grep -c . "$PODCAST_SEARCH_CACHE")
                [ "$idx" -le "$total" ] || { echo "序号超范围 (共 $total 条)" >&2; exit 1; }
                target_line=$(sed -n "${idx}p" "$PODCAST_SEARCH_CACHE")
                id="${target_line%% *}"
                name="${target_line#* }"
                n=$("$NETEASE_HELPER" list podcast "$id" 2>/dev/null | grep -c .)
                [ "${n:-0}" -gt 0 ] || { echo "播客 #$id 取不到曲目" >&2; exit 1; }
                echo "播客 #$id ($name): $n 期 ($ord), 切换中..."
                send "switch-to-netease podcast $id $ord"
                ;;
            *) echo "用法: radioctl netease login|status|playlist <id>|album <id>|podcast [id]|program <id>|song <id>|fm|daily|search <关键词>|play <序号>|podcast-search <关键词>|podcast-play <序号>" >&2; exit 1 ;;
        esac
        ;;
    soundcloud)
        sub="${2:-}"; shift 2
        case "$sub" in
            status) exec "$SC_HELPER" status ;;
            likes)
                # likes [permalink] [repeat|loop|seq|shuffle]; 默认 SC_DEFAULT_LIKES (plusdrei)
                permalink="${1:-$SC_DEFAULT_LIKES}"; ord="${2:-loop}"
                case "$permalink" in
                    repeat|loop|seq|shuffle) ord="$permalink"; permalink="$SC_DEFAULT_LIKES" ;;
                esac
                # 支持直接传入主页链接如 https://soundcloud.com/plusdrei
                permalink=$(sed -E 's|https?://(m\.)?soundcloud\.com/||; s|/.*||' <<<"$permalink")
                case "$permalink" in
                    ''|*[!A-Za-z0-9_-]*) echo "用户名非法 (A-Za-z0-9_-): $permalink" >&2; exit 1 ;;
                esac
                n=$("$SC_HELPER" list likes "$permalink" 2>/dev/null | grep -c .)
                [ "${n:-0}" -gt 0 ] || { echo "@$permalink 的 likes 取不到曲目" >&2; exit 1; }
                echo "likes @$permalink: $n 首 ($ord), 切换中..."
                send "switch-to-soundcloud likes $permalink $ord"
                ;;
            playlist)
                [ $# -ge 1 ] || { echo "用法: radioctl soundcloud playlist <歌单id或完整链接> [repeat|loop|seq|shuffle]" >&2; exit 1; }
                raw="$1"; ord="${2:-loop}"
                id=$("$SC_HELPER" resolve-id "$raw" 2>/dev/null || true)
